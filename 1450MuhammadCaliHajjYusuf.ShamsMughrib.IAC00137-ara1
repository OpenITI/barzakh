~~484، "مرآة الجنان": ج4ص100، "البداية والنهاية": ج13ص167، "غاية النهاية": ج2ص208
~~برقم 3277، "النجوم الزاهرة": ج6ص339، "طبقات المفسرين للسيوطي": ص98 برقم 115،
